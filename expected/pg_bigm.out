CREATE INDEX test_bigm_btree ON test_bigm USING btree (col2);
SELECT * FROM pg_gin_pending_stats('test_bigm_btree');
ERROR:  relation "test_bigm_btree" is not a GIN index
DROP INDEX test_bigm_btree;
